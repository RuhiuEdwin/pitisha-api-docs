{
  "name": "tefo-design",
  "version": "0.1.0",
  "description": "Tefo shared design system: tokens, surfaces, React primitives and brand assets.",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./tokens": { "types": "./src/tokens.ts", "default": "./src/tokens.ts" },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./fonts.css": "./src/fonts.css",
    "./theme.css": "./src/theme.css",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "fonts", "assets", "README.md", "TOKENS.md", "MIGRATION.md", "DESIGN.md"],
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "assets": "tsx scripts/build-assets.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reference": "vite --config reference/vite.config.ts",
    "reference:build": "vite build --config reference/vite.config.ts",
    "check": "npm run tokens && npm run lint && npm run typecheck && npm run test && npm run reference:build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
